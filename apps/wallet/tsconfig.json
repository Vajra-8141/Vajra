{
  "compilerOptions": {
    "target": "ES2022", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src"]
}
