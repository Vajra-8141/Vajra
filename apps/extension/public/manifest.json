{
  "manifest_version": 3,
  "name": "VAJRA",
  "version": "0.1.0",
  "description": "Connects dapps to a VAJRA account. Holds the daily key only: the master key is never here.",
  "action": { "default_popup": "popup.html", "default_title": "VAJRA" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["inpage.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["relay.js"], "run_at": "document_start" }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://altmempool.forshtat.com/*", "https://altmempoolgateway.forshtat.com/*"]
}
