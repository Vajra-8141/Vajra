@@ -0,0 +1,71 @@
+import { getAddress } from "viem";
+import type { FrameTransaction } from "@skandha/types/lib/contracts/FrameTx.js";
+
+/**
+ * ERC-8421 BUDGET-010. EIP-8141's single `MAX_VERIFY_GAS` covers the whole
+ * validation prefix, so it cannot be raised for a staked entity without also
+ * raising it for every unstaked entity in the same transaction. The standard
+ * alternative mempool tracks the sum per entity instead.
+ */
+export const MAX_VERIFY_GAS_PER_ENTITY = BigInt(100_000);
+export const MAX_VERIFY_GAS_STAKED_ENTITY = BigInt(1_000_000);
+
+/** The parts of `ValidationPrefixMatch` this needs. */
+interface PrefixFrames {
+  frames: { frameIndex: number }[];
+}
+
+export type EntityBudgetResult = { valid: true } | { valid: false; reason: string };
+
+/**
+ * The validation gas each entity is responsible for: the sum of `limits.execution`
+ * over its frames, plus the intrinsic signature cost, which BUDGET-010 charges
+ * to `tx.sender`.
+ *
+ * A frame's entity is its resolved target, which holds for every prefix frame:
+ * a `pre_verify` frame shares its target with the approving frame it precedes,
+ * so it lands on the same entity, as BUDGET-010 requires.
+ *
+ * Every frame up to the last prefix frame is counted, including a leading
+ * `expiry_verify` frame that `prefix.frames` omits. That frame belongs to no
+ * entity in the rules, but it still declares a limit, and leaving it out would
+ * let it carry unbounded gas past this check. It is charged to `tx.sender`.
+ */
+export function entityVerifyGas(
+  tx: Pick<FrameTransaction, "frames" | "sender">,
+  prefix: PrefixFrames,
+  signatureCost: bigint
+): Map<string, bigint> {
+  const sender = getAddress(tx.sender);
+  const gas = new Map<string, bigint>([[sender, signatureCost]]);
+  const lastPrefixIndex = Math.max(...prefix.frames.map((f) => f.frameIndex));
+  const attributed = new Set(prefix.frames.map((f) => f.frameIndex));
+  for (let i = 0; i <= lastPrefixIndex; i++) {
+    const frame = tx.frames[i];
+    const entity = attributed.has(i) ? getAddress(frame.target ?? tx.sender) : sender;
+    gas.set(entity, (gas.get(entity) ?? BigInt(0)) + frame.limits.execution);
+  }
+  return gas;
+}
+
+/**
+ * Holds every entity to its own budget. `isStaked` takes a checksummed address
+ * and has to mean what the rest of validation means by staked, so the caller
+ * derives it from `ReputationService.checkStake`.
+ */
+export function checkEntityBudgets(
+  tx: Pick<FrameTransaction, "frames" | "sender">,
+  prefix: PrefixFrames,
+  signatureCost: bigint,
+  isStaked: (entity: string) => boolean
+): EntityBudgetResult {
+  for (const [entity, gas] of entityVerifyGas(tx, prefix, signatureCost)) {
+    const staked = isStaked(entity);
+    const budget = staked ? MAX_VERIFY_GAS_STAKED_ENTITY : MAX_VERIFY_GAS_PER_ENTITY;
+    if (gas > budget) {
+      const name = staked ? "MAX_VERIFY_GAS_STAKED_ENTITY" : "MAX_VERIFY_GAS_PER_ENTITY";
+      return { valid: false, reason: `entity ${entity} declares ${gas} validation gas, which exceeds ${name} ${budget}` };
+    }
+  }
+  return { valid: true };
+}
