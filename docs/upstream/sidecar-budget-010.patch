diff --git a/packages/executor/test/services/UserOpValidation/utils/entityBudget.test.ts b/packages/executor/test/services/UserOpValidation/utils/entityBudget.test.ts
new file mode 100644
index 0000000..f6f3123
--- /dev/null
+++ b/packages/executor/test/services/UserOpValidation/utils/entityBudget.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it } from "vitest";
+import {
+  MAX_VERIFY_GAS_PER_ENTITY,
+  MAX_VERIFY_GAS_STAKED_ENTITY,
+  checkEntityBudgets,
+  entityVerifyGas,
+} from "../../../../src/services/UserOpValidation/utils/entityBudget.js";
+
+const SENDER = "0x1111111111111111111111111111111111111111";
+const PAYMASTER = "0x2222222222222222222222222222222222222222";
+const FACTORY = "0x3333333333333333333333333333333333333333";
+
+const frame = (target: string | null, execution: bigint) => ({
+  mode: 1,
+  flags: 0,
+  target,
+  limits: { execution, state: BigInt(0) },
+  value: BigInt(0),
+  data: "0x",
+});
+
+const tx = (...frames: ReturnType<typeof frame>[]) => ({ sender: SENDER, frames }) as never;
+const prefix = (...frameIndexes: number[]) => ({ frames: frameIndexes.map((frameIndex) => ({ frameIndex })) });
+const none = () => false;
+const all = () => true;
+const only = (address: string) => (entity: string) => entity === address;
+
+describe("entityVerifyGas", () => {
+  it("charges the signature cost to the sender", () => {
+    const gas = entityVerifyGas(tx(frame(null, BigInt(500))), prefix(0), BigInt(2800));
+    expect(gas.get(SENDER)).toBe(BigInt(3300));
+  });
+
+  it("charges the sender even when a paymaster is the payer", () => {
+    const gas = entityVerifyGas(tx(frame(null, BigInt(10)), frame(PAYMASTER, BigInt(20))), prefix(0, 1), BigInt(100));
+    expect(gas.get(SENDER)).toBe(BigInt(110));
+    expect(gas.get(PAYMASTER)).toBe(BigInt(20));
+  });
+
+  it("sums a pre_verify frame into the entity of the approving frame it precedes", () => {
+    const gas = entityVerifyGas(tx(frame(PAYMASTER, BigInt(7)), frame(PAYMASTER, BigInt(8))), prefix(0, 1), BigInt(0));
+    expect(gas.get(PAYMASTER)).toBe(BigInt(15));
+  });
+
+  it("separates a factory from the sender", () => {
+    const gas = entityVerifyGas(tx(frame(FACTORY, BigInt(30)), frame(null, BigInt(40))), prefix(0, 1), BigInt(0));
+    expect(gas.get(FACTORY)).toBe(BigInt(30));
+    expect(gas.get(SENDER)).toBe(BigInt(40));
+  });
+
+  it("counts a leading expiry_verify frame against the sender", () => {
+    const gas = entityVerifyGas(tx(frame(FACTORY, BigInt(99)), frame(null, BigInt(1))), prefix(1), BigInt(0));
+    expect(gas.get(SENDER)).toBe(BigInt(100));
+    expect(gas.get(FACTORY)).toBeUndefined();
+  });
+
+  it("ignores body frames after the prefix", () => {
+    const gas = entityVerifyGas(tx(frame(null, BigInt(1)), frame(null, BigInt(1_000_000_000))), prefix(0), BigInt(0));
+    expect(gas.get(SENDER)).toBe(BigInt(1));
+  });
+});
+
+describe("checkEntityBudgets", () => {
+  it("holds an unstaked sender to the per-entity budget", () => {
+    const result = checkEntityBudgets(tx(frame(null, MAX_VERIFY_GAS_PER_ENTITY + BigInt(1))), prefix(0), BigInt(0), none);
+    expect(result).toMatchObject({ valid: false });
+    expect(result.valid === false && result.reason).toMatch(/MAX_VERIFY_GAS_PER_ENTITY/);
+  });
+
+  it("counts the signature cost toward the unstaked budget", () => {
+    const result = checkEntityBudgets(tx(frame(null, MAX_VERIFY_GAS_PER_ENTITY)), prefix(0), BigInt(100), none);
+    expect(result.valid).toBe(false);
+  });
+
+  it("admits an unstaked sender exactly at the budget", () => {
+    expect(checkEntityBudgets(tx(frame(null, MAX_VERIFY_GAS_PER_ENTITY)), prefix(0), BigInt(0), none).valid).toBe(true);
+  });
+
+  it("lets a staked sender use the staked budget", () => {
+    expect(checkEntityBudgets(tx(frame(null, BigInt(400_000))), prefix(0), BigInt(2800), all).valid).toBe(true);
+  });
+
+  it("holds a staked sender to the staked budget", () => {
+    const result = checkEntityBudgets(tx(frame(null, MAX_VERIFY_GAS_STAKED_ENTITY + BigInt(1))), prefix(0), BigInt(0), all);
+    expect(result.valid === false && result.reason).toMatch(/MAX_VERIFY_GAS_STAKED_ENTITY/);
+  });
+
+  it("keeps an unstaked paymaster bound while the sender is staked", () => {
+    const frames = tx(frame(null, BigInt(400_000)), frame(PAYMASTER, MAX_VERIFY_GAS_PER_ENTITY + BigInt(1)));
+    const result = checkEntityBudgets(frames, prefix(0, 1), BigInt(0), only(SENDER));
+    expect(result.valid === false && result.reason).toContain(PAYMASTER);
+  });
+
+  it("gives each unstaked entity its own budget rather than sharing one", () => {
+    const frames = tx(frame(null, BigInt(90_000)), frame(PAYMASTER, BigInt(90_000)));
+    expect(checkEntityBudgets(frames, prefix(0, 1), BigInt(0), none).valid).toBe(true);
+  });
+
+  it("does not let an oversized expiry_verify frame slip past", () => {
+    const frames = tx(frame(FACTORY, MAX_VERIFY_GAS_PER_ENTITY + BigInt(1)), frame(null, BigInt(1)));
+    expect(checkEntityBudgets(frames, prefix(1), BigInt(0), none).valid).toBe(false);
+  });
+});
